<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://localhost/MantenimientoLiquidadciones/</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <MSDeployServiceURL>localhost</MSDeployServiceURL>
    <DeployIisAppPath>Default Web Site</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>InProc</MSDeployPublishMethod>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>false</EnableMsDeployAppOffline>
    <UserName />
    <_SavePWD>false</_SavePWD>
    <_TargetId>IISWebDeploy</_TargetId>
    <PublishDatabaseSettings>
      <Objects>
        <ObjectGroup Name="CLUBS_AX_TESTEntities" Order="1" Enabled="False">
          <Destination Path="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBContext" DbContext="Mantenimiento_Liquidaciones.CLUBS_AX_TESTEntities, Mantenimiento-Liquidaciones" Origin="Configuration" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="GESTCRMCEEntities" Order="2" Enabled="False">
          <Destination Path="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBContext" DbContext="Mantenimiento_Liquidaciones.GESTCRMCEEntities, Mantenimiento-Liquidaciones" Origin="Configuration" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="PreciosStadaEntities" Order="3" Enabled="False">
          <Destination Path="" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=172.31.234.7;Initial Catalog=PRECIOS_STADA;User ID=sa;Password=Bayvit1429;MultipleActiveResultSets=True;Application Name=EntityFramework" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\PreciosStadaEntities_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="metadata=res://*/PreciosStada.csdl|res://*/PreciosStada.ssdl|res://*/PreciosStada.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=172.31.234.7;initial catalog=PRECIOS_STADA;user id=sa;password=Bayvit1429;MultipleActiveResultSets=True;App=EntityFramework&quot;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)CLUBS_AX_TESTEntities-Web.config Connection String" />
    <MSDeployParameterValue Include="$(DeployParameterPrefix)GESTCRMCEEntities-Web.config Connection String" />
    <MSDeployParameterValue Include="$(DeployParameterPrefix)PreciosStadaEntities-Web.config Connection String" />
  </ItemGroup>
</Project>