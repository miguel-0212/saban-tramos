@model IEnumerable<Mantenimiento_Liquidaciones.AnexoCambioMaterial>

@{
    ViewBag.Title = "Anexo Cambio Material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="jumbotron" style="pointer-events:all;">
    <div>
        <input type="hidden" id="typeView" value="Index" />
        @(Html.Kendo().PanelBar()
         .Name("filtrosAnexoCambioMaterial")
         .ExpandMode(PanelBarExpandMode.Multiple)
         .HtmlAttributes(new { @Class = "divFiltros kendoClass", data_idTable= "tablaAnexoCambioMaterial" })
         .Events(ev => ev.Collapse("onCollapseFilters").Expand("onExpanseFilters"))
         .Items(panelbar =>
         {
             panelbar.Add().Text("Filtros - Anexo Cambio Material")
                 .Expanded(true)
                 .Content(
                 @<div>
                     <div class="row buttonSearchFilters columns columns-right btn-group float-right">
                         <a id="searchFiltrosAnexoCambioMaterial" class="btn btn-secondary filterDataTableWithFilters saveSessionStorageFilters" title="Buscar" data-idTable="tablaAnexoCambioMaterial">
                             <i class="fas fa-search"></i>
                         </a>
                         <a id="removeFiltrosAnexoCambioMaterial" class="btn btn-secondary removeDataTableWithFilters removeSessionStorageFilters" title="Borrar"  data-idTable="tablaAnexoCambioMaterial">
                             <i class="fas fa-trash"></i>
                         </a>
                     </div>
                     <div class="textAllignInherit">
                         <div class="row col-12">
                              <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                 <label class="labelFilters">Código Nacional Old: </label>
                                 <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="CN_old" />
                             </div>
                              <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                <label class="labelFilters">Código Nacional New: </label>
                                <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="CN_NEW" />
                            </div>
                               <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                <label class="labelFilters">Cod Material SAP Old: </label>
                                <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="SAP_old" />
                            </div>

                         </div>
                         <div class="row col-12">
                             <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                <label class="labelFilters">Cod Material SAP New: </label>
                                <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="SAP_new" />
                            </div>


                          </div>
                         <div class="row col-12 divSeconLineFilter">
                         </div>
                     </div>
                 </div>
             );
         })
		)

    </div>
    <div>
        @(Html.Kendo().Grid<AnexoCambioMaterial>()
                    .Name("tablaAnexoCambioMaterial")
                    .Excel(excel => excel
                        .FileName("tablaAnexoCambioMaterial.xlsx")
                        )
                    .Height(800)
                    .Columns(columns =>
                    {
                        columns.Command(command =>
                        {
                            //command.Custom("Detail").Text(" ").IconClass("fas fa-info-circle").HtmlAttributes(new { @class = "IconCommandClass", Title = "Ver detalle" }).Click("goToDetail");
                            command.Destroy() // Utiliza el método Destroy para la eliminación
                                       .Text(" ")
                                       .IconClass("fas fa-trash-alt")
                                       .HtmlAttributes(new { @class = "IconCommandClass", Title = "Eliminar" });
                            command.Edit();
                        }).Width(150);
                        columns.Bound(p => p.CN_old).Title("Código Nacional Old");
                        columns.Bound(p => p.CN_NEW).Title("Código Nacional New");
                        columns.Bound(p => p.SAP_old).Title("Cod Material SAP Old");
                        columns.Bound(p => p.SAP_new).Title("Cod Material SAP New");
                        columns.Bound(p => p.dFechaInicio).Title("Fecha Inicio").Format("{0:dd/MM/yyyy HH:mm:ss}");
                        columns.Bound(p => p.dFechaFin).Title("Fecha Fin").Format("{0:dd/MM/yyyy HH:mm:ss}");
                        columns.Bound(p => p.dFechaActualizacion).Title("Fecha Actualización").Format("{0:dd/MM/yyyy HH:mm:ss}");
                        columns.Bound(p => p.sUsuarioActualizacion).Title("Usuario Actualizacion");
                    }).ToolBar(toolbar =>
                    {
                        toolbar.Template(
            @<text>
                <div class="row" style="display:contents">
                    <a class="k-button k-button-icontext" title="Crear Nuevo" id="crearNuevo" >
                        <span class="k-icon fas fa-plus colorIcons"></span> Crear nuevo
                    </a>
                </div>
                <div class="row" style="display:contents">

                </div>
                <div class="buttonsRightToolbar">
                    <a class="k-button k-button-icontext" href="#" onclick="exportarExcel('tablaAnexoCambioMaterial')">
                        <span class="k-icon k-i-excel"></span>Exportar a Excel
                    </a>
                    <a class="k-button k-button-icontext" href="@Url.Action("CargarArchivo", "AnexoCambioMateriales")">
                        <span class="k-icon k-i-upload"></span>Carga Masiva
                    </a>
                    <div class="refreshBtnContainer">
                        <a class="k-pager-refresh k-link k-button k-button-icon colorIcons" title="Refresh"><span class="k-icon k-i-reload"></span></a>
                    </div>
                    <span class="k-textbox k-grid-search k-display-flex">
                        <input autocomplete="off" class="k-input" placeholder="Search..." title="Search..." type="text">
                        <span class="k-input-icon">
                            <span class="k-icon k-i-search colorIcons"></span>
                        </span>
                    </span>
                </div>
            </text>);
                    })
        .PersistSelection(true)
        .Scrollable(sc => sc.Enabled(true))
        .Pageable(pager => pager
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .PageSizes(new[] { 5, 10, 25, 50, 75, 100, 500, 1000 })
        ).Search(s =>
        {
        s.Field(c => c.CN_old);
        s.Field(c => c.CN_NEW);
        s.Field(c => c.SAP_old);
        s.Field(c => c.SAP_new);

        })
        .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn)
        .ShowIndexes(true)
        )
        .Filterable()
        .ColumnMenu(menu =>
        {
        menu.Columns(columns =>
        {
        columns
        .Sort("asc");
        });
        })
        .HtmlAttributes(new { @Class = "kendoClass tableGridKendo", data_idTable = "tablaAnexoCambioMaterial" })
        .Events(events =>
        {

        events.Edit("onEdit");
        })
        .DataSource(dataSource => dataSource
        .Ajax()
        .ServerOperation(true)
        .Sort(sort => sort.Add(s => s.dFechaActualizacion).Descending()) // Ordenar por dFechaActualizacion descendente
        .PageSize(10)
        .Read(read => read.Action("ReadAnexoCambioMaterial", "AnexoCambioMateriales").Data("additionalDataIndexAnexoCambioMaterial"))
        .Model(model =>
        {
        model.Id(p => p.CN_NEW);
        model.Field(p => p.CN_old).Editable(true);

        model.Field(p => p.SAP_new);
        model.Field(p => p.SAP_old);
        model.Field(p => p.dFechaActualizacion).Editable(true);
        model.Field(p => p.sUsuarioActualizacion).Editable(true);
        })
        .Update(update => update.Action("Edit", "AnexoCambioMateriales"))
        .Destroy(destroy => destroy.Action("Delete", "AnexoCambioMateriales"))
        .Create(create => create.Action("Create", "AnexoCambioMateriales"))
        .Events(events => events
        .Error("onError") // Manejar errores del DataSource
        )
        )
        .Editable(editable => editable
        .DisplayDeleteConfirmation(false)
        .Mode(GridEditMode.PopUp)
        .CreateAt(GridInsertRowPosition.Top)


        )


        )
    </div>
</div>
<div id="dialog-confirmacion" style="display: none">
    ¿Estás seguro de que deseas eliminar este registro?
</div>
<script>

    function onError(e) {
        // Si hay errores de validación, mostrarlos en el popup y evitar que se cierre
        if (e.errors) {
            var validator = $("#crearNuevoWindow").kendoValidator().data("kendoValidator");
            validator.hideMessages();

            $.each(e.errors, function (propertyName, error) {
                var input = $("[name='" + propertyName + "']", e.form);
                validator.showMessagesFor(input);
            });

            e.preventDefault();
        }
    }

    

    function onGridRemove(e) {
        e.preventDefault();

        var id = e.model.sIdAnexoCambioMaterial;
        debugger;
        var dialog = $("#dialog-confirmacion").data("kendoDialog");
        if (!dialog) {
            dialog = $("#dialog-confirmacion").kendoDialog({
                width: "450px",
                title: "Confirmar Eliminación",
                closable: false,
                modal: true,
                actions: [
                    {
                        text: 'Cancelar',
                        action: function () {
                            dialog.close();
                        }
                    },
                    {
                        text: 'Eliminar',
                        primary: true,
                        action: function () {
                           // Realizar la eliminación
                            $.ajax({
                                url: '@Url.Action("Delete", "AnexoCambioMaterial")', // URL de tu acción de eliminación
                                type: 'POST',
                                data: { sIdAnexoCambioMaterial: id }, // Pasar el ID del registro a eliminar
                                success: function(result) {
                                    if (result.success) { // Asumiendo que tu acción retorna un objeto JSON con una propiedad 'success'
                                        e.sender.dataSource.remove(e.model); // Elimina el registro de la grilla
                                        dialog.close();
                                        // Puedes mostrar un mensaje de éxito aquí si es necesario
                                    } else {
                                        alert("Error al eliminar el registro: " + result.message); // Muestra el mensaje de error si lo hay
                                    }
                                },
                                error: function() {
                                    alert("Ocurrió un error al intentar eliminar el registro.");
                                }
                            });

                        }
                    }
                ]
            }).data("kendoDialog");
        }

        // Abrir el diálogo
        dialog.open();
    }

    $("#crearNuevo").click(function (e) {
        e.preventDefault();
        var grid = $("#tablaAnexoCambioMaterial").data("kendoGrid");
        grid.addRow();
    });

</script>
