@model IEnumerable<Mantenimiento_Liquidaciones.sabana>

@{
    ViewBag.Title = "Maestra Tipo Materiales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="jumbotron" style="pointer-events:all;">
    <div>
        <input type="hidden" id="typeView" value="Index" />
        @(Html.Kendo().PanelBar()
         .Name("filtrosSabana")
         .ExpandMode(PanelBarExpandMode.Multiple)
         .HtmlAttributes(new { @Class = "divFiltros kendoClass", data_idTable= "tablaSabana" })
         .Events(ev => ev.Collapse("onCollapseFilters").Expand("onExpanseFilters"))
         .Items(panelbar =>
         {
             panelbar.Add().Text("Filtros - Sabana")
                 .Expanded(true)
                 .Content(
                 @<div>
                     <div class="row buttonSearchFilters columns columns-right btn-group float-right">
                         <a id="searchFiltrossabana" class="btn btn-secondary filterDataTableWithFilters saveSessionStorageFilters" title="Buscar" data-idTable="tablaSabana">
                             <i class="fas fa-search"></i>
                         </a>
                         <a id="removeFiltrossabana" class="btn btn-secondary removeDataTableWithFilters removeSessionStorageFilters" title="Borrar"  data-idTable="tablaSabana">
                             <i class="fas fa-trash"></i>
                         </a>
                     </div>
                     <div class="textAllignInherit">
                         <div class="row col-12">
                              <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                 <label class="labelFilters">Mayorista Agrupador: </label>
                                 <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="sMayoristaAgrupador" />
                             </div>
                              <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                <label class="labelFilters">Red: </label>
                                <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="sRed" />
                            </div>
                               <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                <label class="labelFilters">Id Tipo Venta: </label>
                                <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="IdTipoVenta" />
                            </div>

                         </div>
                         <div class="row col-12 divSeconLineFilter">
                              <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                                <label class="labelFilters">Id Club: </label>
                                <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="idClub" />
                            </div>
                             <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                               <label class="labelFilters">Id Sub Club: </label>
                               <input type="text" class="inputsFilters filterInputTable filterClassSaveData" id="idSubClub" />
                            </div>
                          </div>
                     </div>
                 </div>
             );
         })
		)

    </div>
    <div>
        @(Html.Kendo().Grid<sabana>()
                        .Name("tablaSabana")
                        .Excel(excel => excel
                            .FileName("tablaSabana.xlsx")
                            )
                        .Height(800)
                        .ColumnMenu()
                        .Columns(columns =>
                        {
                            columns.Command(command =>
                            {
                                //command.Custom("Detail").Text(" ").IconClass("fas fa-info-circle").HtmlAttributes(new { @class = "IconCommandClass", Title = "Ver detalle" }).Click("goToDetail");
                                command.Destroy() // Utiliza el método Destroy para la eliminación
                                           .Text(" ")
                                           .IconClass("fas fa-trash-alt")
                                           .HtmlAttributes(new { @class = "IconCommandClass", Title = "Eliminar" });
                                command.Edit();
                            }).Width(120);
                            columns.Bound(p => p.sMayoristaAgrupador).Title("Mayorista Agrupador");
                            columns.Bound(p => p.sRed).Title("Red");
                            columns.Bound(p => p.IdPeriodicidad).Title("Id Periodicidad");
                            columns.Bound(p => p.IdTipoVenta).Title("Id Tipo Venta");
                            columns.Bound(p => p.idClub).Title("Id Club");
                            columns.Bound(p => p.idSubClub).Title("Id Sub Club");
                            columns.Bound(p => p.IdTipoDescuento).Title("Id Tipo Descuento");
                            columns.Bound(p => p.dFechaIni).Title("Fecha Inicio").Format("{0:dd/MM/yyyy}");
                            columns.Bound(p => p.dFechaFin).Title("Fecha Fin").Format("{0:dd/MM/yyyy}");
                            columns.Bound(p => p.IdTramo).Title("Id Tramo");
                            columns.Bound(p => p.IdTipoTramo).Title("Id Tipo Tramo");
                            columns.Bound(p => p.dFechaActualizacion).Title("Fecha Actualización").Format("{0:dd/MM/yyyy HH:mm:ss}");
                            columns.Bound(p => p.sUsuarioActualizacion).Title("Usuario Actualizacion");
                        }).ToolBar(toolbar =>
                        {
                        toolbar.Template(
            @<text>
                <div class="row" style="display:contents">
                    <a class="k-button k-button-icontext" title="Crear Nuevo" id="crearNuevo" >
                        <span class="k-icon fas fa-plus colorIcons"></span> Crear nuevo
                    </a>
                </div>
                <div class="buttonsRightToolbar">
                    <a class="k-button k-button-icontext" href="#" onclick="exportarExcel('tablaSabana')">
                        <span class="k-icon k-i-excel"></span>Exportar a Excel
                    </a>
                    <div class="refreshBtnContainer">
                        <a class="k-pager-refresh k-link k-button k-button-icon colorIcons" title="Refresh"><span class="k-icon k-i-reload"></span></a>
                    </div>
                    <span class="k-textbox k-grid-search k-display-flex">
                        <input autocomplete="off" class="k-input" placeholder="Search..." title="Search..." type="text">
                        <span class="k-input-icon">
                            <span class="k-icon k-i-search colorIcons"></span>
                        </span>
                    </span>
                </div>
            </text>);
                        })
                    .PersistSelection(true)
                    .Scrollable(sc => sc.Enabled(true))
                    .Pageable(pager => pager
                        .Numeric(true)
                        .Info(true)
                        .PreviousNext(true)
                        .PageSizes(new[] { 5, 10, 25, 50, 75, 100, 500, 1000 })
                    ).Search(s =>
                    {
                        s.Field(c => c.sMayoristaAgrupador);
                        s.Field(c => c.sRed);
                        s.Field(c => c.sIdMayoristaAgrupador);
                        s.Field(c => c.idSubClub);
                        s.Field(c => c.idClub);


                    })
                    .Sortable(sortable => sortable
                        .AllowUnsort(true)
                        .SortMode(GridSortMode.MultipleColumn)
                        .ShowIndexes(true)
                    )
                    .Filterable()
                    .ColumnMenu(menu =>
                    {
                        menu.Columns(columns =>
                        {
                            columns
                            .Sort("asc");
                        });
                    })
                    .HtmlAttributes(new { @Class = "kendoClass tableGridKendo", data_idTable = "tablaSabana" })
                    .Events(events =>
                    {

                        events.Edit("onEdit");

                    })
            .DataSource(dataSource => dataSource
                .Ajax()
                .ServerOperation(false)
                .Sort(sort => sort.Add(s => s.dFechaActualizacion).Descending()) // Ordenar por dFechaActualizacion descendente
                .PageSize(10)
                .Read(read => read.Action("ReadSabanas", "Sabanas").Data("additionalDataIndexSabana"))
                .Model(model =>
                {
                    model.Id(p => p.sIdMayoristaAgrupador);
                    model.Field(p => p.sRed).Editable(true);

                    model.Field(p => p.IdTipoVenta);

                })
            .Update(update => update.Action("Edit", "Sabanas"))
            .Destroy(destroy => destroy.Action("Delete", "Sabanas"))
            .Create(create => create.Action("Create", "Sabanas"))

            .Events(events => events
                .Error("onError") // Manejar errores del DataSource
                .RequestStart("onRequestStart")

             )
         )
        .Events(events =>
        {
            events.Remove("onGridRemove");

        })
        .Editable(editable => editable
            .DisplayDeleteConfirmation(false)
            .Mode(GridEditMode.PopUp)
            .CreateAt(GridInsertRowPosition.Top)


        )


	)
    </div>
</div>
<div id="dialog-confirmacion" style="display: none">
    ¿Estás seguro de que deseas eliminar este registro?
</div>
<script>

    function onRequestStart(e) {
        // Acceder a los datos que se están enviando
        var data = e.data;
        debugger;
        // Inspeccionar el objeto 'data'
        console.log(data); // Imprimir el objeto en la consola del navegador

        // Puedes modificar los datos antes de enviarlos si es necesario
        // data.algunaPropiedad = "nuevo valor";

        // O puedes cancelar la solicitud si es necesario
        // e.preventDefault(); 
    }
    function onError(e) {
        // Si hay errores de validación, mostrarlos en el popup y evitar que se cierre
        if (e.errors) {
            var validator = $("#crearNuevoWindow").kendoValidator().data("kendoValidator");
            validator.hideMessages();

            $.each(e.errors, function (propertyName, error) {
                var input = $("[name='" + propertyName + "']", e.form);
                validator.showMessagesFor(input);
            });

            e.preventDefault();
        }
    }


    function onGridRemove(e) {
        e.preventDefault();

        var dataToSend = JSON.stringify(e.model); 
        var dialog = $("#dialog-confirmacion").data("kendoDialog");
        if (!dialog) {
            dialog = $("#dialog-confirmacion").kendoDialog({
                width: "450px",
                title: "Confirmar Eliminación",
                closable: false,
                modal: true,
                actions: [
                    {
                        text: 'Cancelar',
                        action: function () {
                            recargarTabla("tablaSabana");
                            dialog.close();
                        }
                    },
                    {
                        text: 'Eliminar',
                        primary: true,
                        action: function () {
                           // Realizar la eliminación
                            $.ajax({
                                url: '@Url.Action("Delete", "Sabanas")', // URL de tu acción de eliminación
                                type: 'POST',
                                contentType: "application/json; charset=utf-8",
                                data: dataToSend, // Pasar el ID del registro a eliminar
                                success: function(result) {
                                    if (result.success) { // Asumiendo que tu acción retorna un objeto JSON con una propiedad 'success'
                                        e.sender.dataSource.remove(e.model); // Elimina el registro de la grilla
                                        recargarTabla("tablaSabana");
                                        dialog.close();
                                        // Puedes mostrar un mensaje de éxito aquí si es necesario
                                    } else {
                                        alert("Error al eliminar el registro: " + result.message); // Muestra el mensaje de error si lo hay
                                    }
                                },
                                error: function() {
                                    alert("Ocurrió un error al intentar eliminar el registro.");
                                }
                            });

                        }
                    }
                ]
            }).data("kendoDialog");
        }

        // Abrir el diálogo
        dialog.open();
    }

    $("#crearNuevo").click(function (e) {
        e.preventDefault();
        var grid = $("#tablaSabana").data("kendoGrid");
        grid.addRow();
    });

</script>
